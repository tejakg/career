---
const items = [
  ['/', 'Home'], ['/experience/', 'Experience'], ['/projects/', 'Projects'], ['/skills/', 'Skills'], ['/resume/', 'Resume'], ['/contact/', 'Contact']
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Teja K G home">
      <span class="brand-mark" aria-hidden="true">TG</span>
      <span class="brand-name">Teja K G</span>
    </a>
    <nav aria-label="Primary navigation">
      {items.map(([href, label]) => {
        const normalizedTarget = href.replace(/\/+$/, '') || '/';
        const active = current === normalizedTarget;
        return <a href={href} class={active ? 'active' : ''} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
  </div>
</header>

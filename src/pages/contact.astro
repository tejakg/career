---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/career';
---
<Layout title="Contact Teja K G | Manufacturing Engineering & Automation" description="Contact Teja K G in Bengaluru for opportunities in manufacturing engineering, manufacturing automation, engineering productivity, semiconductor equipment, medical devices, supplier engineering and V&V.">
  <div class="page-intro"><div class="eyebrow">Contact</div><h1>Make the first conversation about the engineering problem.</h1><p>Based in Bengaluru, Karnataka. Relevant to manufacturing engineering, manufacturing automation, engineering productivity, semiconductor equipment, medical devices, supplier engineering and verification &amp; validation.</p><div class="profile-meta"><span>Bengaluru</span><span>Manufacturing Engineering</span><span>Automation</span><span>Engineering Productivity</span></div></div>
  <section><div class="contact"><div><div class="section-kicker">Professional contact</div><h2>One click away.</h2><p class="muted">Only intentionally public professional routes are listed here. No home address or private phone number belongs on a career website.</p></div><div class="contact-list"><a class="contact-link" href={`mailto:${contact.email}`}><strong>Email</strong><span>{contact.email}</span></a><a class="contact-link" href={contact.linkedin}><strong>LinkedIn</strong><span>@tejakg</span></a><a class="contact-link" href={contact.github}><strong>GitHub</strong><span>tejakg</span></a><a class="contact-link" href="/resume/"><strong>Resume</strong><span>Web resume + PDF</span></a></div></div></section>
</Layout>

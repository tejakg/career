---
import Layout from '../layouts/Layout.astro';
import { projects, experience, education } from '../data/career';
---
<Layout title="Teja K G | Manufacturing Engineer, Automation & Engineering Productivity" description="Teja K G is a VCP Design Engineer - Mechanical at GE HealthCare in Bengaluru, with experience across manufacturing engineering, automation, semiconductor equipment, medical devices, Python test automation, V&V and supplier engineering.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow">VCP Design Engineer - Mechanical · Manufacturing · Automation</div>
      <h1 id="hero-title">I solve manufacturing problems by combining engineering, automation and software.</h1>
      <p class="lede">Mechanical and manufacturing engineer working across <strong>manufacturing productivity, automation, electronics, verification &amp; validation, and supplier engineering</strong> for complex hardware in medical devices and semiconductor equipment.</p>
      <div class="hero-proof" aria-label="Career snapshot"><span>GE HealthCare</span><span>Lam Research</span><span>Medical Devices</span><span>Semiconductor Equipment</span><span>Bengaluru</span></div>
      <div class="actions"><a class="button primary" href="/experience/">View experience <span aria-hidden="true">→</span></a><a class="button" href="/resume/">View resume</a><a class="button" href="/contact/">Contact</a></div>
      <p class="microcopy">Mechanical engineering · manufacturing productivity · automation · V&amp;V · supplier engineering</p>
    </div>
    <div class="hero-visual engineering-visual" aria-label="Engineering problem-solving workflow">
      <div class="visual-status"><span class="status-dot"></span> ENGINEERING METHOD <span class="status-live">06 STEPS</span></div>
      <div class="schematic-stage"><div class="radar-ring ring-a" aria-hidden="true"></div><div class="radar-ring ring-b" aria-hidden="true"></div><div class="radar-sweep" aria-hidden="true"></div>
        <svg viewBox="0 0 520 360" role="img" aria-label="Six-step engineering method: observe, measure, engineer, automate, validate and standardize">
          <defs>
            <linearGradient id="wire" x1="0" x2="1"><stop stop-color="#78d5ff" stop-opacity=".15"/><stop offset=".5" stop-color="#78d5ff"/><stop offset="1" stop-color="#a5f3d0" stop-opacity=".35"/></linearGradient>
            <filter id="nodeGlow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="4" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            <path id="flow-one" d="M144 92 H178"/><path id="flow-two" d="M342 92 H376"/><path id="flow-three" d="M438 124 V178 H290"/><path id="flow-four" d="M178 226 H144"/><path id="flow-five" d="M82 262 V278 H178"/>
          </defs>
          <g class="schematic-grid" fill="none" stroke="#33414e" stroke-width="1" opacity=".72"><path d="M34 54H486M34 154H486M34 254H486M34 330H486"/><path d="M82 30V330M260 30V330M438 30V330"/></g>
          <g class="wire-layer" fill="none" stroke="url(#wire)" stroke-width="2.5" stroke-linecap="round"><use href="#flow-one" class="flow-wire"/><use href="#flow-two" class="flow-wire"/><use href="#flow-three" class="flow-wire"/><use href="#flow-four" class="flow-wire"/><use href="#flow-five" class="flow-wire"/></g>
          <g class="system-node" fill="#0d151d" stroke="#78d5ff" stroke-width="2">
            <rect x="42" y="56" width="102" height="72" rx="12"/><rect x="178" y="56" width="164" height="72" rx="12"/><rect x="376" y="56" width="102" height="72" rx="12"/>
            <rect x="42" y="190" width="102" height="72" rx="12"/><rect x="178" y="190" width="164" height="72" rx="12"/><rect x="178" y="278" width="164" height="50" rx="12"/>
          </g>
          <g class="node-step" fill="#78d5ff" font-family="ui-monospace,monospace" font-size="9"><text x="56" y="75">01</text><text x="192" y="75">02</text><text x="390" y="75">03</text><text x="56" y="209">04</text><text x="192" y="209">05</text><text x="192" y="296">06</text></g>
          <g class="node-label" fill="#f4f7fa" font-family="ui-monospace,monospace" font-size="11"><text x="56" y="99">OBSERVE</text><text x="56" y="116" fill="#9ba8b5">FIND CONSTRAINT</text><text x="192" y="99">MEASURE</text><text x="192" y="116" fill="#9ba8b5">QUANTIFY LOSS</text><text x="390" y="99">ENGINEER</text><text x="390" y="116" fill="#9ba8b5">DESIGN FIX</text><text x="56" y="233">AUTOMATE</text><text x="56" y="250" fill="#9ba8b5">SENSING / CODE</text><text x="192" y="233">VALIDATE</text><text x="192" y="250" fill="#9ba8b5">REAL HARDWARE</text><text x="192" y="309">STANDARDIZE</text><text x="286" y="309" fill="#9ba8b5">SUSTAIN GAIN</text></g>
          <g class="connection-nodes" fill="#78d5ff" filter="url(#nodeGlow)"><circle cx="144" cy="92" r="4"/><circle cx="178" cy="92" r="4"/><circle cx="342" cy="92" r="4"/><circle cx="376" cy="92" r="4"/><circle cx="438" cy="128" r="4"/><circle cx="438" cy="178" r="4"/><circle cx="290" cy="178" r="4"/><circle cx="178" cy="226" r="4"/><circle cx="144" cy="226" r="4"/><circle cx="82" cy="262" r="4"/><circle cx="82" cy="278" r="4"/><circle cx="178" cy="278" r="4"/></g>
          <g class="flow-packets" fill="#ffffff" filter="url(#nodeGlow)"><circle r="3.5"><animateMotion dur="1.8s" repeatCount="indefinite"><mpath href="#flow-one"/></animateMotion></circle><circle r="3.5"><animateMotion dur="2s" begin=".35s" repeatCount="indefinite"><mpath href="#flow-two"/></animateMotion></circle><circle r="3.5"><animateMotion dur="2.8s" begin=".7s" repeatCount="indefinite"><mpath href="#flow-three"/></animateMotion></circle><circle r="3.5"><animateMotion dur="1.8s" begin="1s" repeatCount="indefinite"><mpath href="#flow-four"/></animateMotion></circle><circle r="3.5"><animateMotion dur="2.4s" begin="1.3s" repeatCount="indefinite"><mpath href="#flow-five"/></animateMotion></circle></g>
          <g class="schematic-meta" fill="#82909e" font-family="ui-monospace,monospace" font-size="10"><text x="40" y="348">EXAMPLE: IMU FIXTURE / 90% CYCLE-TIME REDUCTION</text></g>
        </svg>
      </div>
      <div class="visual-caption"><div><strong>FROM CONSTRAINT TO RESULT</strong><span>Observe the process. Measure the loss. Engineer and validate the intervention.</span></div><span class="visual-counter">01 / 06</span></div>
    </div>
  </section>

  <section class="edge-panel" aria-labelledby="edge-title"><div class="section-head"><div><div class="section-kicker">My engineering edge</div><h2 id="edge-title">The useful work happens at the boundary.</h2></div><p>I start with the physical process, then bring in sensing, electronics, software or automation when they remove a real constraint.</p></div><div class="edge-flow"><span>OBSERVE</span><i>→</i><span>MEASURE</span><i>→</i><span>ENGINEER</span><i>→</i><span>AUTOMATE</span><i>→</i><span>VALIDATE</span><i>→</i><span>STANDARDIZE</span></div></section>

  <section aria-labelledby="proof"><div class="section-head"><div><div class="section-kicker">Proof</div><h2 id="proof">Measured impact, not keyword volume.</h2></div><p>Four outcomes show what changed because of the engineering work.</p></div><div class="proof-grid proof-grid-four"><div class="proof"><strong>90%</strong><span>cycle-time reduction<br/>IMU-based fixture</span></div><div class="proof"><strong>$1M+</strong><span>annual savings<br/>fixture/process improvement</span></div><div class="proof"><strong>50%</strong><span>test-cycle reduction<br/>Python automation</span></div><div class="proof"><strong>30%</strong><span>less trial-and-error<br/>DELMIA simulation</span></div></div></section>

  <section aria-labelledby="bring"><div class="section-head"><div><div class="section-kicker">What I bring</div><h2 id="bring">A manufacturing engineer with unusual range.</h2></div><p>Deep enough in physical manufacturing to understand the process. Broad enough to use electronics, software and automation when they are the right tools.</p></div><div class="bring-grid"><article><span>01</span><h3>Manufacturing Productivity</h3><p>Cycle-time reduction, fixture development, process improvement and cost reduction.</p></article><article><span>02</span><h3>Engineering Automation</h3><p>Python, hardware test automation, computer vision and AI-assisted engineering workflows.</p></article><article><span>03</span><h3>Complex Hardware</h3><p>Mechanical + electronics + software across physical systems and manufacturing processes.</p></article><article><span>04</span><h3>High-Reliability Products</h3><p>Medical devices, semiconductor equipment, supplier engineering, V&amp;V and risk retirement.</p></article></div></section>

  <section aria-labelledby="work"><div class="section-head"><div><div class="section-kicker">Selected work</div><h2 id="work">Five engineering problems worth investigating.</h2></div><p>Start with the result. Open the case study when the engineering reasoning matters.</p></div><div class="project-grid">{projects.map((project,index)=><article class="project"><div class="project-top"><span class="project-index">0{index+1}</span><span class="eyebrow">{project.tag}</span></div><h3>{project.title}</h3><p>{project.problem}</p><p class="result">{project.result}</p><a class="project-link" href={project.href}>View case study →</a></article>)}</div></section>

  <section aria-labelledby="experience"><div class="section-head"><div><div class="section-kicker">Experience</div><h2 id="experience">From semiconductor equipment to medical imaging.</h2></div><p>Five years across manufacturing engineering, product engineering, supplier programs and V&amp;V.</p></div><div class="timeline">{experience.slice(0,4).map((role,index)=><article class="role"><div class="meta"><span class="role-index">0{index+1}</span><strong>{role.company}</strong><br/>{role.period}<br/>{role.location}</div><div><h3>{role.role}</h3><p>{role.summary}</p></div></article>)}</div><div class="actions"><a class="button" href="/experience/">View complete timeline →</a></div></section>

  <section aria-labelledby="education"><div class="section-head"><div><div class="section-kicker">Education</div><h2 id="education">Mechanical engineering foundation.</h2></div><p><strong>{education.degree}</strong>, {education.specialization}, {education.institution}, {education.location}, {education.year}.</p></div></section>

  <section aria-labelledby="fit"><div class="fit-panel"><div><div class="section-kicker">Where I fit</div><h2 id="fit">Roles where manufacturing depth and automation overlap.</h2><p class="muted">Manufacturing engineering, manufacturing automation, engineering productivity, manufacturing technology, semiconductor equipment, medical-device manufacturing/V&amp;V, supplier engineering, and product/process engineering.</p></div><div class="fit-list"><a href="/manufacturing-engineering/">Manufacturing Engineering</a><a href="/manufacturing-automation/">Manufacturing Automation</a><a href="/semiconductor-equipment/">Semiconductor Equipment</a><a href="/medical-device-engineering/">Medical Device Engineering</a></div></div></section>

  <section class="final-cta"><div class="contact"><div><div class="section-kicker">Next</div><h2>Looking for hard engineering problems.</h2></div><div><p class="lede">Based in Bengaluru. Open to opportunities where manufacturing engineering, automation and engineering productivity intersect.</p><div class="actions"><a class="button primary" href="mailto:teja@gowlla.in">Email me</a><a class="button" href="https://www.linkedin.com/in/tejakg/">LinkedIn</a><a class="button" href="/resume/">Resume</a></div></div></div></section>
</Layout>

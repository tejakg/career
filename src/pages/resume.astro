---
import Layout from '../layouts/Layout.astro';
import { contact, education, experience, projects, skills } from '../data/career';
---
<Layout title="Resume | Teja K G | Manufacturing Engineer" description="Resume of Teja K G, VCP Design Engineer - Mechanical at GE HealthCare with experience across manufacturing engineering, automation, semiconductor equipment, medical devices, V&V and supplier engineering.">
  <div class="page-intro"><div class="eyebrow">Resume</div><h1>The concise version of the engineering story.</h1><p>A recruiter-friendly résumé with verified chronology and quantified impact. The Markdown source remains the repository source of truth; this page is the readable web version.</p></div>
  <section><div class="resume-shell"><article class="resume-card">
    <div class="eyebrow">Teja K G</div><h2>VCP Design Engineer - Mechanical</h2><p class="muted">Bengaluru, Karnataka · Manufacturing Engineering · Automation · Engineering Productivity</p>
    <h3>Profile</h3><p>Mechanical and manufacturing engineer working across manufacturing productivity, automation, electronics, verification &amp; validation, and supplier engineering for complex hardware in medical devices and semiconductor equipment. Strongest at physical engineering problems that cross disciplinary boundaries: quantify the loss, engineer the intervention, automate where useful, validate with evidence, and standardize the result.</p>
    <h3>Selected impact</h3><div class="metric-grid"><div class="metric-card"><div class="metric-value">90%</div><strong>Cycle-time reduction</strong><span>IMU-based fixture</span></div><div class="metric-card"><div class="metric-value">$1M+</div><strong>Annual savings</strong><span>Fixture/process improvement</span></div><div class="metric-card"><div class="metric-value">50%</div><strong>Test-cycle reduction</strong><span>Python automation</span></div><div class="metric-card"><div class="metric-value">30%</div><strong>Less trial-and-error</strong><span>DELMIA simulation</span></div></div>
    <h3>Experience</h3>{experience.map((role)=><div class="role-block"><div class="role"><div class="meta"><strong>{role.company}</strong><br/>{role.period}<br/>{role.location}</div><div><h3>{role.role}</h3><p>{role.summary}</p><ul>{role.bullets.slice(0,role.company==='Lam Research' && role.period.includes('2021') ? 5 : 4).map(b=><li>{b}</li>)}</ul></div></div></div>)}
    <h3>Education</h3><p><strong>{education.degree}, {education.specialization}</strong><br/>{education.institution} · {education.location} · {education.year}</p>
    <h3>Core skills</h3>{Object.entries(skills).map(([name,list])=><p><strong>{name}:</strong> {list.join('; ')}</p>)}
  </article>
  <aside class="resume-side"><a class="button primary" href="/Teja-K-G-Resume.pdf">Download PDF →</a><a class="button" href="https://github.com/tejakg/career/blob/main/Resume.md">View Resume.md →</a><div class="resume-stat"><strong>5 yrs+</strong><span>engineering experience across semiconductor equipment and medical imaging</span></div><div class="resume-stat"><strong>6</strong><span>verified impact signals: cycle time, cost, testing and automation</span></div><div class="resume-stat"><strong>2021</strong><span>B.E. Mechanical Engineering, The National Institute of Engineering</span></div><div class="contact-links"><a class="contact-link" href={contact.linkedin}><strong>LinkedIn</strong><span>@tejakg</span></a><a class="contact-link" href={`mailto:${contact.email}`}><strong>Email</strong><span>{contact.email}</span></a></div></aside></div></section>
</Layout>

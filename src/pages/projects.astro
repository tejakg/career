import Layout from '../layouts/Layout.astro';
import { projects } from '../data/career';
---
<Layout title="Engineering Projects | Manufacturing Automation, V&V & Supplier Engineering | Teja K G" description="Detailed engineering case studies by Teja K G covering manufacturing fixtures, Python hardware automation, DELMIA simulation, medical-device supplier transition and AI/LLM documentation automation.">
  <div class="topic-intro"><div class="eyebrow">Selected engineering work</div><h1>Problems, constraints, engineering decisions and measured results.</h1><p>The projects below are the work I would want a hiring manager to ask about in an interview. The focus is not on the tool; it is on the engineering problem and what changed.</p></div>
  <section><div class="resume-card">
    <article class="case-study" id="imu-fixture"><div class="case-meta">01<br/>Manufacturing<br/>Sensors</div><div class="case-content"><h2>IMU-Based Manufacturing Fixture</h2><p><strong>Problem.</strong> The top-plate shaft could jam in the chamber hole, causing repeated rework, long setup/assembly time and line-down risk.</p><h3>Engineering decision</h3><p>I ideated, designed and developed a fixture using IMU sensing to measure the absolute position of the top plate and chamber and quantify planar misalignment. The intent was to replace operator-dependent judgement with measurable positional information.</p><h3>Validation</h3><p>The fixture was exercised through multiple real assemblies by production technicians. Assembly time and labour-hour reduction were then measured against the prior process.</p><div class="result-callout"><strong>Result: 90% cycle-time reduction, more than $1M annual savings, and elimination of line-down events caused by the jam condition.</strong></div></div></article>
    <article class="case-study" id="hardware-validation"><div class="case-meta">02<br/>Automation<br/>Python</div><div class="case-content"><h2>Automated Hardware Validation</h2><p><strong>Problem.</strong> Repetitive hardware validation consumed engineering time and limited throughput.</p><h3>Engineering decision</h3><p>I developed a Python-based hardware testing system to automate repeatable validation workflows and reduce manual execution.</p><h3>Validation</h3><p>The automated process was exercised against the required hardware test flow and used to support SEMI S2/S8 compliance-oriented activities.</p><div class="result-callout"><strong>Result: 50% reduction in test cycles.</strong></div></div></article>
    <article class="case-study" id="assembly-simulation"><div class="case-meta">03<br/>Simulation<br/>DELMIA</div><div class="case-content"><h2>Assembly Workflow Simulation</h2><p><strong>Problem.</strong> Assembly planning relied heavily on physical trial and error.</p><h3>Engineering decision</h3><p>I used DELMIA to simulate assembly workflows before physical execution, allowing process issues to be identified earlier.</p><div class="result-callout"><strong>Result: 30% reduction in trial-and-error time.</strong></div></div></article>
    <article class="case-study" id="mobile-xray-transition"><div class="case-meta">04<br/>Medical Devices<br/>Supplier</div><div class="case-content"><h2>Critical Mobile X-Ray Supplier Transition</h2><p><strong>Problem.</strong> A manufacturing shortage threatened the customer commissioning timeline for critical mobile X-ray components.</p><h3>Engineering decision</h3><p>I worked with the supplier through prototypes, assembly guidance, documentation, V&amp;V and risk-retirement testing. I also designed a fixture-based approach that allowed the tool to ship without the constrained assembly operation, with field engineering completing the deferred work during commissioning.</p><h3>Validation</h3><p>The approach preserved the required engineering and validation path while changing where the constrained assembly step occurred.</p><div class="result-callout"><strong>Result: shipment enabled while protecting the customer commissioning timeline.</strong></div></div></article>
    <article class="case-study" id="tpi-automation"><div class="case-meta">05<br/>AI / LLM<br/>Documentation</div><div class="case-content"><h2>Test Procedure Instruction Automation</h2><p><strong>Problem.</strong> Creating Test Procedure Instructions was repetitive and documentation-heavy.</p><h3>Engineering decision</h3><p>I built a computer-vision/LLM-based hackathon solution to automate TPI documentation generation.</p><div class="result-callout"><strong>Result: hackathon finalist project with an estimated $120k/year saving opportunity.</strong></div></div></article>
  </div></section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/career';
---
<Layout title="Manufacturing Automation & Engineering Projects | Teja K G" description="Selected engineering projects in manufacturing automation, productivity improvement, hardware validation, supplier transition, assembly simulation, and AI-assisted engineering.">
  <div class="page-intro"><div class="eyebrow">Projects</div><h1>Manufacturing automation and engineering projects.</h1><p>Selected work across productivity improvement, hardware test automation, manufacturing fixtures, supplier transition, simulation and AI-assisted engineering. Each project is framed as problem, action and result.</p></div>
  <section><div class="project-grid">{projects.map((p, index) => <article class="project"><div class="project-top"><span class="project-index">0{index + 1}</span><span class="eyebrow">{p.tag}</span></div><h2>{p.title}</h2><p><strong>Problem.</strong> {p.problem}</p><p><strong>Action.</strong> {p.action}</p><p class="result">Result. {p.result}</p></article>)}</div></section>
</Layout>

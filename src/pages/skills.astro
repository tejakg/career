---
import Layout from '../layouts/Layout.astro';
import { skills } from '../data/career';
---
<Layout title="Manufacturing Engineering, Automation & V&V Skills | Teja K G" description="Technical skills across manufacturing engineering, engineering productivity, automation, Python, simulation, verification and validation, supplier engineering, electronics and product engineering.">
  <div class="page-intro"><div class="eyebrow">Skills</div><h1>Manufacturing engineering, automation and V&amp;V capabilities.</h1><p>The toolkit spans manufacturing productivity, Python automation, simulation, hardware validation, supplier engineering, electronics and product engineering. The value comes from combining these capabilities around a physical engineering problem.</p></div>
  <section><div class="skill-grid">{Object.entries(skills).map(([name, list]) => <div class="skill"><h2>{name}</h2><div class="pill-list">{list.map(item => <span class="pill">{item}</span>)}</div></div>)}</div></section>
</Layout>

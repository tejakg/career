---
import Header from '../components/Header.astro';

export interface Props { title: string; description: string; path?: string; image?: string; }
const { title, description, path = Astro.url.pathname, image = '/og-image.svg' } = Astro.props;
const canonical = new URL(path, Astro.site);
const socialImage = new URL(image.replace(/^\//, ''), Astro.site).toString();
const isHome = Astro.url.pathname === '/';
const siteName = 'Teja K G';
const jsonLd = {
  '@context': 'https://schema.org', '@graph': [
    {'@type':'Person','@id':'https://teja.gowlla.in/#person',name:'Teja K G',url:'https://teja.gowlla.in/',image:socialImage,email:'mailto:teja@gowlla.in',jobTitle:'VCP Design Engineer - Mechanical',description:'Mechanical and manufacturing engineer working across manufacturing productivity, engineering automation, electronics, verification and validation, supplier engineering, medical devices and semiconductor equipment.',worksFor:{'@type':'Organization',name:'GE HealthCare'},alumniOf:{'@type':'CollegeOrUniversity',name:'The National Institute of Engineering'},address:{'@type':'PostalAddress',addressLocality:'Bengaluru',addressRegion:'Karnataka',addressCountry:'IN'},sameAs:['https://www.linkedin.com/in/tejakg/','https://github.com/tejakg'],knowsAbout:['Manufacturing Engineering','Engineering Productivity','Manufacturing Automation','Mechanical Engineering','Electronics','Python','Hardware Test Automation','Verification and Validation','Supplier Engineering','Medical Devices','Semiconductor Manufacturing','Fixture Development','DELMIA Simulation','AI and LLM Engineering']},
    {'@type':'WebSite','@id':'https://teja.gowlla.in/#website',url:'https://teja.gowlla.in/',name:siteName,description:'Professional engineering portfolio of Teja K G.',publisher:{'@id':'https://teja.gowlla.in/#person'}},
    {'@type':isHome?'ProfilePage':'WebPage','@id':`${canonical.toString()}#webpage`,url:canonical.toString(),name:title,description,isPartOf:{'@id':'https://teja.gowlla.in/#website'},...(isHome?{mainEntity:{'@id':'https://teja.gowlla.in/#person'}}:{})}
  ]
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Teja K G" /><meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" /><meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical.toString()} /><link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable profile summary" />
    <meta property="og:type" content="website" /><meta property="og:site_name" content={siteName} /><meta property="og:locale" content="en_IN" /><meta property="og:url" content={canonical.toString()} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={socialImage} /><meta property="og:image:alt" content="Teja K G, manufacturing and engineering productivity engineer" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="theme-color" content="#07090c" /><meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="stylesheet" href="/styles.css" /><link rel="stylesheet" href="/premium.css" /><link rel="stylesheet" href="/recruiter.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div><a class="skip-link" href="#main-content">Skip to content</a><Header /><div class="page-grid" aria-hidden="true"></div>
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div><strong>Teja K G</strong><span> · VCP Design Engineer - Mechanical · Manufacturing · Automation</span></div><div class="footer-links"><a href="https://www.linkedin.com/in/tejakg/" rel="me">LinkedIn</a><span>·</span><a href="mailto:teja@gowlla.in">Email</a><span>·</span><span>© {new Date().getFullYear()}</span></div></footer>
    <script>const updateProgress=()=>{const max=document.documentElement.scrollHeight-window.innerHeight,pct=max>0?(window.scrollY/max)*100:0;document.getElementById('scroll-progress-bar')?.setAttribute('style',`width:${pct}%`)};window.addEventListener('scroll',updateProgress,{passive:true});updateProgress();</script>
  </body>
</html>

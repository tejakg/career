---
import Header from '../components/Header.astro';

export interface Props { title: string; description: string; path?: string; image?: string; }
const { title, description, path = Astro.url.pathname, image = '/og-image.svg' } = Astro.props;
const canonical = new URL(path, Astro.site);
const root = Astro.url.pathname === '/' ? './' : '../';
const favicon = `${root}favicon.svg`;
const stylesheet = `${root}styles.css`;
const socialImage = new URL(image.replace(/^\//, ''), Astro.site).toString();
const isHome = Astro.url.pathname === '/';
const siteName = 'Teja K G';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://teja.gowlla.in/#person',
      name: 'Teja K G',
      url: 'https://teja.gowlla.in/',
      image: socialImage,
      jobTitle: 'Manufacturing / Engineering Productivity Engineer',
      description: 'Engineer working across manufacturing engineering, engineering productivity, automation, mechanical engineering, electronics, verification and validation, supplier engineering, medical devices and semiconductor equipment.',
      worksFor: { '@type': 'Organization', name: 'GE HealthCare' },
      sameAs: ['https://github.com/tejakg'],
      knowsAbout: ['Manufacturing Engineering','Engineering Productivity','Manufacturing Automation','Mechanical Engineering','Electronics','Python','Hardware Test Automation','Verification and Validation','Supplier Engineering','Medical Devices','Semiconductor Manufacturing','Fixture Development','DELMIA Simulation','AI and LLM Engineering']
    },
    {
      '@type': 'WebSite',
      '@id': 'https://teja.gowlla.in/#website',
      url: 'https://teja.gowlla.in/',
      name: siteName,
      description: 'Professional engineering portfolio of Teja K G.',
      publisher: { '@id': 'https://teja.gowlla.in/#person' }
    },
    {
      '@type': isHome ? 'ProfilePage' : 'WebPage',
      '@id': `${canonical.toString()}#webpage`,
      url: canonical.toString(),
      name: title,
      description,
      isPartOf: { '@id': 'https://teja.gowlla.in/#website' },
      ...(isHome ? { mainEntity: { '@id': 'https://teja.gowlla.in/#person' } } : {})
    }
  ]
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Teja K G" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" type="text/plain" href={`${root}llms.txt`} title="AI-readable profile summary" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Teja K G, manufacturing and engineering productivity engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#090d12" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="stylesheet" href={stylesheet} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <div class="page-grid" aria-hidden="true"></div>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div><strong>Teja K G</strong><span> · Manufacturing Engineering · Automation · Engineering Productivity</span></div>
      <div class="footer-links"><a href="https://github.com/tejakg" rel="me">GitHub</a><span>·</span><span>© {new Date().getFullYear()}</span></div>
    </footer>
  </body>
</html>
